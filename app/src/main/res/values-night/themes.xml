<resources>
    <!-- Base application theme. -->
    <style name="Theme.BeatTheBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/dark_green_primary</item>
        <item name="colorPrimaryVariant">@color/dark_green_primary_variant</item>
        <item name="colorOnPrimary">@color/dark_text_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/dark_green_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_green_secondary_variant</item>
        <item name="colorOnSecondary">@color/dark_text_primary</item>

        <!-- Background & surface -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOutline">@color/borderPrimaryOnDark</item>


        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Text colors -->
        <item name="android:textColor">@color/dark_text_primary</item>

        <item name="android:fontFamily">@font/sf_font_family</item>
    </style>
</resources>