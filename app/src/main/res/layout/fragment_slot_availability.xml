            <TextView
                android:id="@+id/header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_bold"
                android:text="@string/check_availability_header_title"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                android:textColor="?android:textColor"
                android:layout_marginTop="8dp"/>

            <!-- Date Dropdown + Refresh button -->
            <LinearLayout
                android:id="@+id/dateSelectorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/spinnerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spinner_label"
                    android:textSize="12sp"
                    android:textColor="?attr/subTextColor" />

                <Spinner
                    android:id="@+id/spinnerDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:entries="@array/date_options" />

            </LinearLayout>

            <!-- Box Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:orientation="vertical">

                <!-- Toggle buttons -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/boxToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/btnBox1">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBox1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:text="Box 1"
                        android:textAllCaps="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBox2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="40dp"
                        android:text="Box 2"
                        android:textAllCaps="false" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

