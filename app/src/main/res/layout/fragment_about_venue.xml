<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh_about"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Carousel -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginBottom="16dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Prev Button -->
                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical|start"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/left"
                    android:src="@drawable/baseline_chevron_left_24" />

                <!-- Next Button -->
                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical|end"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/right"
                    android:src="@drawable/baseline_chevron_right_24" />
            </FrameLayout>

            <!-- Venue Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- Venue Name -->
                <TextView
                    android:id="@+id/tvVenueName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Timings + Status -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Clock + timings -->
                    <TextView
                        android:id="@+id/tvVenueTimings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:text="@string/timings"
                        android:textColor="?android:textColor"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/ic_time_16"
                        app:drawableTint="?android:textColor" />

                    <!-- Open status -->
                    <TextView
                        android:id="@+id/tvVenueStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:drawablePadding="6dp"
                        android:text="@string/venue_status_open"
                        android:textColor="@color/open_status_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_big_dot" />
                </LinearLayout>

                <!-- Address -->
                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/address"
                    android:textColor="?android:textColor"
                    android:textSize="14sp"
                    app:drawableStartCompat="@drawable/ic_location_pin_outline_16"
                    app:drawableTint="?android:textColor" />

            </LinearLayout>

            <!-- Show in Map Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="40dp"
                android:paddingBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeeLocation"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="@string/button_text"
                    android:textColor="?android:textColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="6dp"
                    app:icon="@drawable/ic_location_pin_filled_16"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="?android:textColor"
                    app:strokeColor="?colorPrimary"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Available Sports Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_margin="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/available_sports"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap to see the prices."
                    android:textColor="?android:textColor"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_margin="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_about_venue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAboutVenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hyphenationFrequency="full"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/about_venue_description"
                    android:textColor="?attr/subTextColor"
                    android:textSize="12sp" />

            </LinearLayout>

            <include layout="@layout/view_loader" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>